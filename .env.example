# --- API server ---
PORT=8787
# Optional: without these the API still works, using in-memory storage and no caching.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=prepbyte
REDIS_URL=redis://127.0.0.1:6379
# Requests per minute per IP across the API (default 300). Use 0 to disable while load testing.
# RATE_LIMIT_PER_MIN=300
# Needed only for POST /api/admin/problems/import. Use a long random secret.
ADMIN_API_KEY=replace-with-a-long-random-secret

# Secret used to sign "Sign in with LeetCode" sessions. Set it so those sessions survive restarts.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-another-long-random-secret

# --- Supabase sign-in for Google and email (optional). The server reuses these to verify sessions. ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# --- Client (optional) ---
# Only set this if the API is hosted somewhere other than the same origin / Vite proxy.
# VITE_API_URL=https://api.example.com/api
